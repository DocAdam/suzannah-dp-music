---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import InquiryForm from '../components/InquiryForm.astro';
import { studio, experience, lessons, studioInfo, faqs, verifiedBackground } from '../data/studio';
---
<BaseLayout><Header /><main id="main">
<section class="hero"><div class="shell hero-grid"><div><p class="eyebrow">Springfield, Missouri</p><h1>Private Piano and Violin Lessons</h1><p class="hero-copy">Individual instruction grounded in professional performance, music education, and orchestral experience since 2004.</p><div class="actions"><a class="button" href="#inquiry">Ask About Lessons</a><a class="text-link" href="#about">Learn About the Studio <span aria-hidden="true">↓</span></a></div></div><figure class="hero-image"><img src="/images/violin-studio-detail.jpg" width="1800" height="1678" alt="Close view of a violin in a studio setting" /><figcaption>Private instruction in Springfield, Missouri</figcaption></figure></div></section>
<section id="about" class="section"><div class="shell split"><div><p class="eyebrow">About Suzannah</p><h2>A musician and educator with a steady, individual approach.</h2></div><div class="prose"><p>Suzannah Dolanc Pugh is a music educator, private instructor, and performing violinist. She teaches private piano and violin lessons in Springfield, Missouri.</p><p>Her teaching experience also includes choir classes at Play and Sing His Praises homeschool co-op (PSHP), previous violin teaching at Springfield Lutheran School, and music competition judging or adjudication.</p><ul class="credential-list">{verifiedBackground.map((fact) => <li>{fact}</li>)}</ul><p>Outside the studio, Suzannah is also an avid gardener—another practice shaped by patience, attentive observation, and steady growth.</p><p class="placeholder">[ADD: Teaching philosophy and professional memberships]</p></div></div></section>
<section class="section tinted"><div class="shell"><p class="eyebrow">Professional experience</p><h2>A career across performance and education.</h2><div class="timeline">{experience.map(([title, detail, dates]) => <article><p class="date">{dates}</p><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>
<section id="lessons" class="section"><div class="shell"><p class="eyebrow">Private lessons</p><h2>Two paths, one shared foundation.</h2><div class="lesson-grid">{lessons.map((lesson) => <article class="lesson-card"><div class="instrument-mark" aria-hidden="true">{lesson.instrument === 'Piano' ? 'P' : 'V'}</div><h3>{lesson.instrument}</h3><p>{lesson.lead}</p><dl>{lesson.details.map(([term, definition]) => <><dt>{term}</dt><dd class={definition.startsWith('[') ? 'placeholder' : ''}>{definition}</dd></>)}</dl></article>)}</div></div></section>
<section class="section dark"><div class="shell approach"><div><p class="eyebrow">Teaching approach</p><h2>Fundamentals that support a lifelong relationship with music.</h2></div><p>Lessons are intended to provide clear instruction, healthy technique, musical understanding, consistent practice habits, and room for student-specific goals. <span class="placeholder">[CONFIRM: Teaching philosophy]</span></p></div></section>
<section id="studio" class="section"><div class="shell"><p class="eyebrow">Studio information</p><h2>Useful details, clearly shared.</h2><p class="section-lead">The exact home address is never displayed publicly. See the studio policies for payment, cancellation, makeup, communication, and student-safety details.</p><dl class="info-grid">{studioInfo.map(([term, definition]) => <div><dt>{term}</dt><dd class={definition.includes('[') ? 'placeholder' : ''}>{definition}</dd></div>)}</dl></div></section>
<section class="section tinted"><div class="shell faq-wrap"><p class="eyebrow">Frequently asked questions</p><h2>Before you inquire.</h2>{faqs.map(([question, answer]) => <details><summary>{question}</summary><p class={answer.includes('[') ? 'placeholder' : ''}>{answer}</p></details>)}</div></section>
<section id="inquiry" class="section"><div class="shell"><InquiryForm /><p class="direct-contact">Prefer email? <a href={`mailto:${studio.contactEmail}`}>{studio.contactEmail}</a></p>{studio.scheduling.enabled && <aside class="scheduling"><h2>Schedule an introductory conversation</h2><p>Use this link only for an introductory call or trial-lesson discussion.</p><a class="button" href={studio.scheduling.url}>Open {studio.scheduling.provider}</a></aside>}</div></section>
</main><Footer /></BaseLayout>
