---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Availability from '../components/Availability.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import InquiryForm from '../components/InquiryForm.astro';
import LessonOfferings from '../components/LessonOfferings.astro';
import { studio } from '../data/studio';
---

<BaseLayout title={studio.seo.title} description="Private piano, violin, and limited voice instruction in Springfield, Missouri.">
  <Header />
  <main id="main" class="site-main">
    <Hero />
    <Availability />
    <LessonOfferings />
    <Faq />
    <section id="inquire" class="site-section site-inquire">
      <div class="site-wrap"><InquiryForm /></div>
    </section>
    <About />
  </main>
  <Footer />
</BaseLayout>
