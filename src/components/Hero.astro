---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<section class="site-hero">
  <div class="site-wrap">
    <div class="site-hero-layout">
      <div class="site-hero-copy">
        <p class="eyebrow">Springfield, Missouri · South Springfield</p>
        <h1>Piano &amp; Violin Lessons</h1>
        <p class="site-lede">Individual lessons for children in grades K–12. Complete beginners are welcome; limited voice instruction is available by inquiry.</p>
        <div class="site-actions">
          <a class="site-button" href="#inquire">Ask about an opening</a>
          <a class="site-button site-button-secondary" href="#availability">See studio details</a>
        </div>
      </div>
      <figure class="site-hero-image">
        <img src={`${base}images/suzannah-headshot.png`} width="410" height="612" alt="Suzannah Pugh" />
      </figure>
    </div>
    <div class="decision-grid" aria-label="At a glance">
      <article><span>Openings</span><strong>Accepting students</strong><p>Tuesday &amp; Thursday</p></article>
      <article><span>Lesson times</span><strong>30 or 60 minutes</strong><p>During school hours</p></article>
      <article><span>Tuition</span><strong>$30 or $60</strong><p>Per 30 or 60 minutes</p></article>
      <article><span>Location</span><strong>South Springfield</strong><p>Exact address after acceptance</p></article>
    </div>
  </div>
</section>
