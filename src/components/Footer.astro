---
import { studio } from '../data/studio';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<footer class="site-footer">
  <div class="site-wrap">
    <p><strong>{studio.name}</strong> · <a href={`${base}privacy`}>Privacy</a></p>
    <p>© {new Date().getFullYear()} {studio.name}</p>
  </div>
</footer>
