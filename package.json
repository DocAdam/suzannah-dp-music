{
  "name": "suzannah-pugh-music-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "validate:apps-script": "node --check < apps-script/Code.gs",
    "verify:intake-config": "node scripts/verify-intake-config.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate": "npm run check && npm run validate:apps-script && npm run build && npm run test && npm run validate:links"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.13.0",
    "typescript": "^5.8.3"
  }
}
