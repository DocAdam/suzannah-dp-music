{
  "name": "suzannah-pugh-music-studio",
  "version": "1.0.0",
  "description": "Private piano, violin, and limited voice instruction in Springfield, Missouri.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify:intake-config": "node scripts/verify-intake-config.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate": "npm run check && npm run build && npm run test && npm run test:e2e && npm run validate:links"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.62.1",
    "astro": "^5.13.0",
    "typescript": "^5.8.3"
  }
}
